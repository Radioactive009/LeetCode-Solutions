class Solution {
    public int getSecondLargest(int[] arr) {
        // code here
        int max = 0;
        int secmax = 0;
        for(int i = 0; i<arr.length; i++){
            if(arr[i]>max){
                max = arr[i];
            }
        }
        for(int j = 0; j<arr.length; j++){
            if(arr[j] == max){
                continue;
            }
            else if(arr[j]>secmax){
                secmax = arr[j];
                
            }
           
            
        }
        
        return secmax;
    }
}
